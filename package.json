{
  "name": "koralink-api-health-monitor",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "packages/monitor-core",
    "packages/monitor-web",
    "packages/monitor-react-native"
  ],
  "scripts": {
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build -w backend && npm run build -w frontend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend",
    "db:seed:dev": "npm run db:seed:dev -w backend",
    "db:seed:production": "npm run db:seed:production -w backend",
    "db:assign-marketplace": "npm run db:assign-marketplace -w backend",
    "pack:sdk": "node scripts/pack-sdks.mjs",
    "test": "npm run test -w backend && npm run test -w @koralink/monitor-core"
  }
}
