# ── Database (Neon) ─────────────────────────────────────────────────────────────
# Get this from: https://console.neon.tech → your project → Connection string
# Use the "pooled" connection string for better performance
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Auth ────────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string

# ── Event ingestion ─────────────────────────────────────────────────────────────
# Secret key that clients must send to POST /events
INGEST_API_KEY=change_me_to_a_random_key

# ── CORS ────────────────────────────────────────────────────────────────────────
# Your Vercel frontend URL (comma-separated if multiple)
CORS_ORIGIN=https://your-app.vercel.app

# ── Sentry integration (optional) ───────────────────────────────────────────────
SENTRY_AUTH_TOKEN=
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
SENTRY_BASE_URL=https://sentry.io
SENTRY_WEBHOOK_SECRET=
SENTRY_SYNC_INTERVAL_MS=300000
SENTRY_DISCOVER_QUERY=

# ── Tracked upstream API URLs (optional overrides) ──────────────────────────────
TRACKED_KORALINK_URL=https://www.koralink.org
TRACKED_GWIZA_URL=https://openapi.gwiza.tech
TRACKED_DDIN_URL=https://core-api.ddin.rw/v1/agency
TRACKED_TICKETS_URL=https://resolveit.rw
