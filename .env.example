# PostgreSQL (local install or managed)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/koralink_monitor

# Ingest API key for mobile/web apps (high-entropy secret)
INGEST_API_KEY=change-me-to-a-long-random-string

# JWT for dashboard sessions
JWT_SECRET=change-me-to-another-long-random-string

# CORS: allowed browser origins (comma-separated). Include the monitor dashboard and,
# if the Koralink *web* app calls POST /events from the browser, your web app origin too.
# Example: CORS_ORIGIN=http://localhost:5173,https://app.yourdomain.com
CORS_ORIGIN=http://localhost:5173

# Dashboard admin (seeded on first db:seed)
ADMIN_EMAIL=admin@koralink.local
ADMIN_PASSWORD=change-me

# Server
PORT=3000

# --- Tracked external APIs (dashboard “External APIs” table; optional overrides) ---
TRACKED_KORALINK_URL=https://www.koralink.org
TRACKED_GWIZA_URL=https://openapi.gwiza.tech
TRACKED_DDIN_URL=https://core-api.ddin.rw/v1/agency
TRACKED_TICKETS_URL=https://resolveit.rw

# --- Koralink upstream APIs (reference for client instrumentation) ---
# Koralink main API:              https://www.koralink.org
# Gwiza / MVEND (digital svc):    https://openapi.gwiza.tech
# DDIN (DIGITAL_SERVICES_BASE_URL): https://core-api.ddin.rw/v1/agency
# Tickets (TICKETS_BASE_URL):    https://resolveit.rw

# --- Sentry integration (mobile telemetry) ---
SENTRY_AUTH_TOKEN=
SENTRY_ORG=ict-chamber
SENTRY_PROJECT=market-place
SENTRY_BASE_URL=https://sentry.io
SENTRY_WEBHOOK_SECRET=
SENTRY_SYNC_INTERVAL_MS=180000
SENTRY_DISCOVER_QUERY=has:tags[type]

# Dev-only: wipe & refill demo data in Postgres (requires SEED_DEV_DATA=true)
# SEED_DEV_DATA=true
# npm run db:seed:dev
