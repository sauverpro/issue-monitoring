# PostgreSQL (local install or managed)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/koralink_monitor
DATABASE_URL=postgresql://neondb_owner:npg_Z6X2wDYmQrOz@ep-summer-grass-aw2oqziz-pooler.c-12.us-east-1.aws.neon.tech/koralink?sslmode=require&channel_binding=require


# Ingest API key for mobile/web apps (high-entropy secret)
INGEST_API_KEY=change-me-to-a-long-random-string

# JWT for dashboard sessions
JWT_SECRET=change-me-to-another-long-random-string

# CORS: allowed browser origins (comma-separated). Include the ops dashboard (5173)
# and the combined Monitor frontend (ops + org + platform admin on 5173).
# Example: CORS_ORIGIN=http://localhost:5173,https://app.yourdomain.com
# CORS_ORIGIN=http://localhost:5173
CORS_ORIGIN=https://issue-monitoring-frontend.vercel.app/

# Dashboard admin (seeded on first db:seed)
ADMIN_EMAIL=admin@koralink.local
ADMIN_PASSWORD=change-me

# Server
PORT=3000

# --- Tracked APIs the Koralink app calls (dashboard services; optional overrides) ---
TRACKED_GWIZA_URL=https://openapi.gwiza.tech/
TRACKED_KORALINK_URL=https://www.djyh.rw/api/v1/
TRACKED_DDIN_URL=https://core-api.ddin.rw/v1/
TRACKED_INTEGRA_URL=https://rw-prod.intelligra.io/intelligrapi/
TRACKED_RESOLVEIT_URL=https://resolveit.rw/

# --- Data retention ---
# Days of raw api_events to keep before the nightly retention sweep deletes them.
RETENTION_DAYS=30

# --- Incident alerts (optional) ---
# Slack incoming webhook URL; leave blank to disable alerts.
SLACK_WEBHOOK_URL=
# Public dashboard base URL, used to build incident links in Slack messages.
DASHBOARD_URL=

# --- Tracked APIs (reference for client instrumentation) ---
# MVEND:     https://openapi.gwiza.tech/
# Koralink:  https://www.djyh.rw/api/v1/
# DDIN:      https://core-api.ddin.rw/v1/
# INTEGRA:   https://rw-prod.intelligra.io/intelligrapi/
# RESOLVEIT: https://resolveit.rw/

# --- Sentry integration (mobile telemetry) ---
SENTRY_AUTH_TOKEN=
SENTRY_ORG=ict-chamber
SENTRY_PROJECT=market-place
SENTRY_BASE_URL=https://sentry.io
SENTRY_WEBHOOK_SECRET=
SENTRY_SYNC_INTERVAL_MS=180000
SENTRY_DISCOVER_QUERY=has:tags[type]

# Dev-only: wipe & refill demo data in Postgres (requires SEED_DEV_DATA=true)
# SEED_DEV_DATA=true
# npm run db:seed:dev
