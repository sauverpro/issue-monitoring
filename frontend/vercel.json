{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/auth/login",
      "destination": "https://monitor.soromafresh.com/auth/login"
    },
    {
      "source": "/api/sessions/analytics",
      "destination": "https://monitor.soromafresh.com/session-investigation/analytics"
    },
    {
      "source": "/api/sessions/:sessionId/actions",
      "destination": "https://monitor.soromafresh.com/session-investigation/:sessionId/actions"
    },
    {
      "source": "/api/sessions/:sessionId/failures",
      "destination": "https://monitor.soromafresh.com/session-investigation/:sessionId/failures"
    },
    {
      "source": "/api/sessions",
      "destination": "https://monitor.soromafresh.com/session-investigation"
    },
    {
      "source": "/api/issues/:issueId",
      "destination": "https://monitor.soromafresh.com/issues/:issueId"
    },
    {
      "source": "/api/issues",
      "destination": "https://monitor.soromafresh.com/issues"
    },
    {
      "source": "/api/metrics/:path*",
      "destination": "https://monitor.soromafresh.com/metrics/:path*"
    },
    {
      "source": "/api/health/:path*",
      "destination": "https://monitor.soromafresh.com/health/:path*"
    },
    {
      "source": "/api/incidents/:path*",
      "destination": "https://monitor.soromafresh.com/incidents/:path*"
    },
    {
      "source": "/api/incidents",
      "destination": "https://monitor.soromafresh.com/incidents"
    },
    {
      "source": "/api/powerbi/:path*",
      "destination": "https://monitor.soromafresh.com/powerbi/:path*"
    },
    {
      "source": "/api/endpoints/:path*",
      "destination": "https://monitor.soromafresh.com/endpoints/:path*"
    },
    {
      "source": "/api/events",
      "destination": "https://monitor.soromafresh.com/events"
    },
    {
      "source": "/api/stream",
      "destination": "https://monitor.soromafresh.com/stream"
    },
    {
      "source": "/api/:path*",
      "destination": "https://monitor.soromafresh.com/api/:path*"
    },
    {
      "source": "/console/:path*",
      "destination": "https://monitor.soromafresh.com/console/:path*"
    },
    {
      "source": "/ingest/:path*",
      "destination": "https://monitor.soromafresh.com/ingest/:path*"
    },
    {
      "source": "/sdk/:path*",
      "destination": "https://monitor.soromafresh.com/sdk/:path*"
    },
    {
      "source": "/health",
      "destination": "https://monitor.soromafresh.com/health"
    },
    {
      "source": "/events/(.*)",
      "destination": "https://monitor.soromafresh.com/events/$1"
    },
    {
      "source": "/stream/(.*)",
      "destination": "https://monitor.soromafresh.com/stream/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
